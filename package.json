{
  "name": "llm-wiki-agent",
  "version": "0.1.0",
  "private": true,
  "description": "围绕 LLM wiki 的知识整理 agent：ingest raw 文件 → 编辑成 markdown wiki 库 → 问答",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.115",
    "@ai-sdk/google": "^3.0.120",
    "@ai-sdk/openai": "^3.0.106",
    "@ai-sdk/openai-compatible": "^2.0.74",
    "ai": "^6.0.273"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
